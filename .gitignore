```gitignore
# Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Dependencies
.venv/
venv/
env/
requirements.txt.bak

# Logs
*.log

# Environment variables
.env
.env.local
*.env.*

# Coverage reports
.coverage
htmlcov/
coverage/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg-info/
```