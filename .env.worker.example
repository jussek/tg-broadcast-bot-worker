# Worker Environment Variables
# Copy this file to .env.worker and fill in the values

# Telegram API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Worker secret (must match Vercel WORKER_SECRET)
WORKER_SECRET=

# Supabase (for persistent storage)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server port (for Render/Railway/VPS)
PORT=8080
