# Telegram Broadcast Bot - Environment Variables

# =============================================================================
# ОБЯЗАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ
# =============================================================================

# Telegram Bot Token (от @BotFather)
BOT_TOKEN=your_bot_token_here

# Telegram API Credentials (от https://my.telegram.org/apps)
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Telethon Session String (получить через generate_session.py)
TELEGRAM_SESSION_STRING=your_session_string_here

# Upstash Redis Credentials (от https://upstash.com)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token_here

# QStash Token (от https://upstash.com/products/qstash)
QSTASH_TOKEN=your_qstash_token_here

# =============================================================================
# ОПЦИОНАЛЬНЫЕ ПЕРЕМЕННЫЕ
# =============================================================================

# URL вашего приложения на Vercel (для webhook и QStash callbacks)
APP_URL=https://your-app.vercel.app

# Секрет для проверки webhook от Telegram (рекомендуется)
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Ключ верификации подписи QStash (если нужна дополнительная проверка)
QSTASH_VERIFICATION_KEY=your_qstash_verification_key_here

# =============================================================================
# ИНСТРУКЦИЯ ПО ПОЛУЧЕНИЮ ЗНАЧЕНИЙ
# =============================================================================
# 1. BOT_TOKEN: Создайте бота в @BotFather, получите токен
# 2. API_ID/API_HASH: Зарегистрируйте приложение на my.telegram.org
# 3. TELEGRAM_SESSION_STRING: Запустите generate_session.py локально
# 4. UPSTASH_*: Создайте базу данных на upstash.com
# 5. QSTASH_TOKEN: Активируйте QStash в панели Upstash
# 6. APP_URL: URL после деплоя на Vercel