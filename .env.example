# --- Bot (BotFather) ---
BOT_TOKEN=your_bot_token_here

# --- Webhook ---
# Публичный URL прод-деплоя Vercel (без слэша в конце)
APP_URL=https://your-app.vercel.app
# Секрет, который Telegram будет присылать в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=random_secret_string
# Отдельный сильный серверный секрет для ручных операций и резервного derivation ключа сессий
WEBHOOK_SETUP_SECRET=another_long_random_secret_string

# --- Upstash Redis (состояние, кэш групп, задачи, зашифрованные user sessions) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# --- QStash (отложенные задачи) ---
QSTASH_TOKEN=your_qstash_token
# Опционально: ключ проверки подписи доставок QStash
QSTASH_VERIFICATION_KEY=your_verification_key

# --- Telethon application credentials ---
# API_ID/API_HASH общие для приложения, но Telegram StringSession теперь отдельная у каждого пользователя.
API_ID=123456
API_HASH=your_api_hash

# Рекомендуется: отдельный Fernet key для шифрования персональных Telegram sessions.
# Сгенерировать локально: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Если переменная не задана, код временно выводит ключ из WEBHOOK_SETUP_SECRET.
SESSION_ENCRYPTION_KEY=your_fernet_key_here

# Legacy only: старый единый TELEGRAM_SESSION_STRING больше НЕ используется задачами пользователей.
# Он оставлен только для локальных/административных вызовов без user_id и может быть удалён после миграции.
TELEGRAM_SESSION_STRING=
