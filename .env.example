# Telegram Bot Token (от @BotFather)
BOT_TOKEN=your_bot_token_here

# Upstash Redis Credentials
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# QStash Token (для планировщика задач)
QSTASH_TOKEN=your_qstash_token

# QStash Verification Key (для проверки webhook)
QSTASH_VERIFICATION_KEY=your_verification_key

# Telegram Webhook Secret Token (любая случайная строка)
TELEGRAM_WEBHOOK_SECRET=your_secret_token_here

# Telethon Credentials (для работы с каналами/группами)
API_ID=your_api_id
API_HASH=your_api_hash
TELEGRAM_SESSION_STRING=your_session_string_here

# URL приложения Vercel (без слэша в конце)
APP_URL=https://your-app.vercel.app
