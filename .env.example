# --- Bot (BotFather) ---
BOT_TOKEN=your_bot_token_here

# --- Webhook ---
# Публичный URL прод-деплоя Vercel (без слэша в конце)
APP_URL=https://your-app.vercel.app
# Секрет, который Telegram будет присылать в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=random_secret_string
# Отдельный секрет для ручных операций POST /api/setup-webhook, GET /api/webhook-info
WEBHOOK_SETUP_SECRET=another_random_secret_string

# --- Upstash Redis (состояние, кэш групп, задачи) ---
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_redis_token

# --- QStash (отложенные задачи) ---
QSTASH_TOKEN=your_qstash_token
# Опционально: ключ проверки подписи доставок QStash
QSTASH_VERIFICATION_KEY=your_verification_key

# --- Telethon (user MTProto API: рассылка и получение групп) ---
API_ID=123456
API_HASH=your_api_hash
TELEGRAM_SESSION_STRING=your_session_string_here
